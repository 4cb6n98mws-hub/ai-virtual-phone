{
  "type": "ai-phone-game-draft",
  "version": 1,
  "title": "夜局五子棋 · 单页修复版",
  "draft": {
    "title": "夜局五子棋 · 单页修复版",
    "codeName": "●○",
    "subtitle": "和一个人安静地下完一局",
    "synopsis": "十五路双人五子棋。你执黑先行，选择一名小手机角色坐在棋盘对面；对局、棋力与存档均在本地运行。",
    "playNote": "选择一名角色后开始。你执黑先行，可悔棋或更换本地棋力。下棋本身零 API；结束后只有主动点击「把这局留下」才会写入角色游戏记忆并收进共同抽屉，点击「让对手说一句」才会调用一次角色 API。",
    "coverImage": "",
    "tagsText": "棋类,双人,陪伴,离线",
    "authorName": "k 与叔",
    "roleSlotsText": "[]",
    "pickerHtml": "",
    "gameHtml": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\" />\n  <title>夜局五子棋</title>\n  <style>\n    :root {\n      color-scheme: dark;\n      --ink: #f3efe5;\n      --muted: #98a6ad;\n      --panel: rgba(20, 34, 43, 0.88);\n      --line: rgba(224, 238, 236, 0.13);\n      --teal: #73c7b8;\n      --amber: #e6ad58;\n      --danger: #d98578;\n      --app-text-scale: 1;\n    }\n\n    * { box-sizing: border-box; }\n    html, body { width: 100%; height: 100%; margin: 0; }\n    body {\n      overflow: hidden;\n      color: var(--ink);\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", sans-serif;\n      background:\n        radial-gradient(circle at 88% 7%, rgba(115, 199, 184, .12), transparent 32%),\n        linear-gradient(155deg, #0b151d 0%, #101e27 54%, #071118 100%);\n      -webkit-tap-highlight-color: transparent;\n      user-select: none;\n    }\n\n    button, select { font: inherit; }\n    button { touch-action: manipulation; }\n\n    .screen {\n      height: 100%;\n      display: grid;\n      grid-template-rows: auto auto minmax(0, 1fr) auto;\n      gap: 10px;\n      padding: var(--ai-phone-game-safe-top, 82px) 14px var(--ai-phone-game-safe-bottom, 18px);\n    }\n\n    .topline {\n      display: flex;\n      align-items: flex-end;\n      justify-content: space-between;\n      min-width: 0;\n    }\n\n    .eyebrow {\n      display: block;\n      margin-bottom: 3px;\n      color: var(--teal);\n      font-size: calc(9px * var(--app-text-scale));\n      font-weight: 750;\n      letter-spacing: .18em;\n      text-transform: uppercase;\n    }\n\n    h1 {\n      margin: 0;\n      font-family: Georgia, \"Times New Roman\", \"Songti SC\", serif;\n      font-size: calc(25px * var(--app-text-scale));\n      font-weight: 500;\n      letter-spacing: .02em;\n    }\n\n    .match-label {\n      padding: 5px 8px;\n      border: 1px solid var(--line);\n      border-radius: 999px;\n      color: var(--muted);\n      font-size: calc(9px * var(--app-text-scale));\n      letter-spacing: .11em;\n      white-space: nowrap;\n    }\n\n    .scorebar {\n      display: grid;\n      grid-template-columns: 1fr auto 1fr;\n      align-items: center;\n      gap: 8px;\n      padding: 9px 11px;\n      border: 1px solid var(--line);\n      border-radius: 15px;\n      background: var(--panel);\n      box-shadow: 0 12px 28px rgba(0,0,0,.18);\n    }\n\n    .seat { min-width: 0; }\n    .seat:last-child { text-align: right; }\n    .seat small {\n      display: block;\n      color: var(--muted);\n      font-size: calc(9px * var(--app-text-scale));\n      letter-spacing: .09em;\n      text-transform: uppercase;\n    }\n    .seat strong {\n      display: block;\n      overflow: hidden;\n      margin-top: 2px;\n      font-size: calc(13px * var(--app-text-scale));\n      text-overflow: ellipsis;\n      white-space: nowrap;\n    }\n\n    .score {\n      display: flex;\n      align-items: center;\n      gap: 7px;\n      color: var(--amber);\n      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n      font-size: calc(16px * var(--app-text-scale));\n      font-weight: 800;\n    }\n    .score i { color: #5f737c; font-style: normal; }\n\n    .board-area {\n      min-height: 0;\n      display: grid;\n      place-items: center;\n    }\n\n    .board-frame {\n      width: min(100%, 430px, calc(100vh - var(--ai-phone-game-safe-top, 82px) - 238px));\n      min-width: min(270px, 100%);\n      aspect-ratio: 1;\n      padding: 8px;\n      border: 1px solid rgba(232, 207, 159, .28);\n      border-radius: 20px;\n      background: linear-gradient(145deg, #ab743e, #d09a58 48%, #986132);\n      box-shadow: 0 18px 38px rgba(0,0,0,.34), inset 0 1px rgba(255,255,255,.2);\n    }\n\n    canvas {\n      display: block;\n      width: 100%;\n      height: 100%;\n      border-radius: 13px;\n      background: #c99351;\n      touch-action: none;\n    }\n\n    .control-panel {\n      display: grid;\n      gap: 8px;\n      padding: 10px;\n      border: 1px solid var(--line);\n      border-radius: 16px;\n      background: rgba(13, 25, 33, .94);\n      box-shadow: 0 -10px 30px rgba(0,0,0,.16);\n    }\n\n    .status-row {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 10px;\n      min-height: 26px;\n    }\n\n    #status {\n      overflow: hidden;\n      color: #dce5e3;\n      font-size: calc(12px * var(--app-text-scale));\n      text-overflow: ellipsis;\n      white-space: nowrap;\n    }\n\n    .turn-dot {\n      flex: 0 0 auto;\n      width: 10px;\n      height: 10px;\n      border: 1px solid rgba(255,255,255,.28);\n      border-radius: 50%;\n      background: #0b0f12;\n      box-shadow: 0 0 0 3px rgba(255,255,255,.05);\n    }\n    .turn-dot.white { background: #f0eee8; }\n\n    .actions {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr) auto auto;\n      gap: 7px;\n    }\n\n    select, button {\n      min-height: 38px;\n      border: 1px solid var(--line);\n      border-radius: 11px;\n      color: var(--ink);\n      background: #192b35;\n    }\n\n    select { min-width: 0; padding: 0 28px 0 10px; font-size: calc(11px * var(--app-text-scale)); }\n    button { padding: 0 12px; font-size: calc(11px * var(--app-text-scale)); font-weight: 700; }\n    button:disabled { opacity: .38; }\n    button.primary { border-color: rgba(115,199,184,.44); color: #0c2926; background: var(--teal); }\n    button.ghost { color: #c9d2d2; background: transparent; }\n\n    .end-actions {\n      display: none;\n      grid-template-columns: 1fr 1fr;\n      gap: 7px;\n    }\n    .end-actions.show { display: grid; }\n\n    .reply {\n      display: none;\n      max-height: 72px;\n      overflow: auto;\n      padding: 9px 11px;\n      border-left: 2px solid var(--teal);\n      color: #dce7e4;\n      background: rgba(115,199,184,.08);\n      font-size: calc(11px * var(--app-text-scale));\n      line-height: 1.55;\n      white-space: pre-wrap;\n      user-select: text;\n    }\n    .reply.show { display: block; }\n\n    .api-note {\n      display: none;\n      color: #73858d;\n      font-size: calc(9px * var(--app-text-scale));\n      text-align: center;\n    }\n    .api-note.show { display: block; }\n\n    .toast {\n      position: fixed;\n      left: 50%;\n      bottom: calc(var(--ai-phone-game-safe-bottom, 18px) + 110px);\n      z-index: 10;\n      max-width: calc(100% - 40px);\n      padding: 9px 13px;\n      border: 1px solid rgba(255,255,255,.14);\n      border-radius: 999px;\n      color: var(--ink);\n      background: rgba(7,17,24,.94);\n      box-shadow: 0 12px 30px rgba(0,0,0,.35);\n      font-size: calc(11px * var(--app-text-scale));\n      opacity: 0;\n      pointer-events: none;\n      transform: translate(-50%, 10px);\n      transition: .22s ease;\n      white-space: nowrap;\n    }\n    .toast.show { opacity: 1; transform: translate(-50%, 0); }\n\n    .role-picker {\n      position: fixed;\n      inset: 0;\n      z-index: 30;\n      display: grid;\n      grid-template-rows: auto auto minmax(0, 1fr) auto;\n      gap: 14px;\n      padding: var(--ai-phone-game-safe-top, 82px) 16px var(--ai-phone-game-safe-bottom, 18px);\n      color: var(--ink);\n      background:\n        radial-gradient(circle at 86% 8%, rgba(115,199,184,.13), transparent 33%),\n        linear-gradient(155deg, #0b151d, #101e27 55%, #071118);\n    }\n    .role-picker.is-hidden { display: none; }\n    .role-picker h2 {\n      margin: 5px 0 0;\n      font-family: Georgia, \"Times New Roman\", \"Songti SC\", serif;\n      font-size: calc(28px * var(--app-text-scale));\n      font-weight: 500;\n    }\n    .role-picker-copy { margin: 0; color: var(--muted); font-size: calc(13px * var(--app-text-scale)); line-height: 1.65; }\n    .role-list { min-height: 0; overflow: auto; display: grid; align-content: start; gap: 9px; padding: 2px 1px 8px; }\n    .role-choice {\n      width: 100%; min-height: 66px; display: grid; grid-template-columns: 46px minmax(0,1fr) 18px;\n      align-items: center; gap: 11px; padding: 9px 11px; border: 1px solid var(--line); border-radius: 15px;\n      color: var(--ink); text-align: left; background: rgba(20,34,43,.86); box-shadow: 0 10px 24px rgba(0,0,0,.13);\n    }\n    .role-choice.is-active { border-color: rgba(115,199,184,.7); background: rgba(29,55,61,.94); }\n    .role-avatar { width: 46px; height: 46px; display: grid; place-items: center; overflow: hidden; border-radius: 50%; color: #163630; background: #8fcfc2; font-family: Georgia,serif; font-size: 18px; }\n    .role-avatar img { width: 100%; height: 100%; object-fit: cover; }\n    .role-copy { min-width: 0; }\n    .role-copy strong, .role-copy small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n    .role-copy strong { font-size: calc(14px * var(--app-text-scale)); }\n    .role-copy small { margin-top: 4px; color: var(--muted); font-size: calc(10px * var(--app-text-scale)); }\n    .role-mark { width: 16px; height: 16px; border: 1px solid #60737a; border-radius: 50%; }\n    .role-choice.is-active .role-mark { border: 4px solid var(--teal); }\n    .role-empty { padding: 30px 18px; border: 1px dashed var(--line); border-radius: 15px; color: var(--muted); text-align: center; font-size: calc(13px * var(--app-text-scale)); line-height: 1.6; }\n    .role-start { width: 100%; min-height: 46px; border-color: rgba(115,199,184,.55); color: #0a2824; background: var(--teal); font-weight: 800; }\n\n    @media (max-height: 700px) {\n      .screen { gap: 7px; padding-left: 10px; padding-right: 10px; }\n      h1 { font-size: calc(21px * var(--app-text-scale)); }\n      .scorebar { padding: 7px 9px; }\n      .control-panel { padding: 8px; gap: 6px; }\n      .board-frame { width: min(94vw, 350px, calc(100vh - var(--ai-phone-game-safe-top, 76px) - 210px)); }\n    }\n  </style>\n</head>\n<body>\n  <section class=\"role-picker\" id=\"rolePicker\">\n    <header><span class=\"eyebrow\">Choose your opponent</span><h2>今晚和谁对坐？</h2></header>\n    <p class=\"role-picker-copy\">选择一名角色执白。对局在本地运行，不会因为下棋调用模型。</p>\n    <div class=\"role-list\" id=\"roleList\"><div class=\"role-empty\">正在读取角色……</div></div>\n    <button class=\"role-start\" id=\"roleStart\" disabled>在棋盘边坐下</button>\n  </section>\n  <main class=\"screen\">\n    <header class=\"topline\">\n      <div>\n        <span class=\"eyebrow\">Night table · five in a row</span>\n        <h1>夜局五子棋</h1>\n      </div>\n      <span class=\"match-label\">LOCAL MATCH</span>\n    </header>\n\n    <section class=\"scorebar\" aria-label=\"比分\">\n      <div class=\"seat\">\n        <small>BLACK · YOU</small>\n        <strong id=\"playerName\">你</strong>\n      </div>\n      <div class=\"score\"><span id=\"playerScore\">0</span><i>:</i><span id=\"roleScore\">0</span></div>\n      <div class=\"seat\">\n        <small>WHITE · OPPONENT</small>\n        <strong id=\"roleName\">对弈者</strong>\n      </div>\n    </section>\n\n    <section class=\"board-area\">\n      <div class=\"board-frame\">\n        <canvas id=\"board\" role=\"img\" aria-label=\"十五路五子棋棋盘\"></canvas>\n      </div>\n    </section>\n\n    <section class=\"control-panel\">\n      <div class=\"status-row\"><span id=\"status\">正在摆好棋盘……</span><span class=\"turn-dot\" id=\"turnDot\"></span></div>\n      <div class=\"actions\">\n        <select id=\"difficulty\" aria-label=\"棋力\">\n          <option value=\"easy\">轻松陪你</option>\n          <option value=\"steady\" selected>认真一点</option>\n          <option value=\"hard\">难缠一些</option>\n        </select>\n        <button class=\"ghost\" id=\"undo\">悔棋</button>\n        <button id=\"restart\">新一局</button>\n      </div>\n      <div class=\"end-actions\" id=\"endActions\">\n        <button class=\"primary\" id=\"keep\">把这局留下</button>\n        <button id=\"speak\">让对手说一句</button>\n      </div>\n      <div class=\"reply\" id=\"reply\"></div>\n      <div class=\"api-note\" id=\"apiNote\">“说一句”会调用一次角色 API；下棋本身不会消耗 API。</div>\n    </section>\n  </main>\n  <div class=\"toast\" id=\"toast\"></div>\n\n  <script>\n    (function () {\n      \"use strict\";\n\n      var SIZE = 15;\n      var HUMAN = 1;\n      var ROLE = 2;\n      var canvas = document.getElementById(\"board\");\n      var ctx = canvas.getContext(\"2d\");\n      var host = window.AiPhoneGame || createPreviewHost();\n      var state = freshState();\n      var player = { name: \"你\" };\n      var role = { id: \"preview-role\", name: \"对弈者\" };\n      var aiTimer = 0;\n      var turnToken = 0;\n      var toastTimer = 0;\n      var geometry = { size: 0, pad: 0, step: 0 };\n\n      function freshState() {\n        return {\n          version: 1,\n          board: Array(SIZE * SIZE).fill(0),\n          history: [],\n          turn: HUMAN,\n          thinking: false,\n          over: false,\n          winner: 0,\n          recorded: false,\n          difficulty: \"steady\",\n          scores: { human: 0, role: 0 },\n          matchId: makeId()\n        };\n      }\n\n      function makeId() {\n        return \"gomoku_\" + Date.now() + \"_\" + Math.random().toString(36).slice(2, 8);\n      }\n\n      function createPreviewHost() {\n        return {\n          setTitleBar: async function () { return { ok: true }; },\n          getPlayerProfile: async function () { return { name: \"k\" }; },\n          listAvailableCharacters: async function () { return [{ id: \"preview-role\", name: \"Silas\", avatar: \"\", subtitle: \"坐在棋盘另一侧\" }]; },\n          getRoleLightPackage: async function () { return { characterId: \"preview-role\", characterName: \"Silas\", messages: [] }; },\n          loadGame: async function () {\n            try { return JSON.parse(localStorage.getItem(\"night-gomoku-preview\") || \"null\"); }\n            catch (_) { return null; }\n          },\n          saveGame: async function (data) { localStorage.setItem(\"night-gomoku-preview\", JSON.stringify(data)); },\n          recordGameEvent: async function () { return { ok: true, recorded: 1 }; },\n          callLLM: async function () { return { content: \"下得不错。下一局，我可不会把中间让给你。\" }; }\n        };\n      }\n\n      function validSavedGame(saved) {\n        return saved && saved.version === 1 && Array.isArray(saved.board) && saved.board.length === SIZE * SIZE &&\n          Array.isArray(saved.history) && saved.scores && typeof saved.scores.human === \"number\";\n      }\n\n      function escapeText(value) {\n        return String(value == null ? \"\" : value).replace(/[&<>\\\"]/g, function (ch) {\n          return ({ \"&\":\"&amp;\", \"<\":\"&lt;\", \">\":\"&gt;\", \"\\\"\":\"&quot;\" })[ch];\n        });\n      }\n\n      async function chooseOpponent() {\n        var box = document.getElementById(\"roleList\");\n        var start = document.getElementById(\"roleStart\");\n        var selected = null;\n        var characters;\n        try {\n          characters = await host.listAvailableCharacters();\n        } catch (err) {\n          box.innerHTML = '<div class=\"role-empty\">' + escapeText(err && err.message ? err.message : \"角色读取失败\") + '</div>';\n          throw err;\n        }\n        if (!Array.isArray(characters) || !characters.length) {\n          box.innerHTML = '<div class=\"role-empty\">还没有可选择的角色，请先在小手机里创建角色。</div>';\n          throw new Error(\"没有可选择的角色\");\n        }\n        box.innerHTML = characters.map(function (ch) {\n          var avatar = ch.avatar ? '<img src=\"' + escapeText(ch.avatar) + '\" alt=\"\">' : escapeText(String(ch.name || \"?\").slice(0, 1));\n          return '<button type=\"button\" class=\"role-choice\" data-id=\"' + escapeText(ch.id) + '\">' +\n            '<span class=\"role-avatar\">' + avatar + '</span>' +\n            '<span class=\"role-copy\"><strong>' + escapeText(ch.name) + '</strong><small>' + escapeText(ch.subtitle || \"坐在棋盘另一侧\") + '</small></span>' +\n            '<span class=\"role-mark\"></span></button>';\n        }).join(\"\");\n        var buttons = Array.prototype.slice.call(box.querySelectorAll(\".role-choice\"));\n        buttons.forEach(function (button, index) {\n          button.addEventListener(\"click\", function () {\n            selected = characters[index];\n            buttons.forEach(function (item) { item.classList.remove(\"is-active\"); });\n            button.classList.add(\"is-active\");\n            start.disabled = false;\n          });\n        });\n        return new Promise(function (resolve) {\n          start.addEventListener(\"click\", function () {\n            if (!selected) return;\n            start.disabled = true;\n            start.textContent = \"正在摆棋……\";\n            role.id = String(selected.id || role.id);\n            role.name = String(selected.name || role.name);\n            document.getElementById(\"rolePicker\").classList.add(\"is-hidden\");\n            resolve(selected);\n          }, { once: true });\n        });\n      }\n\n      async function boot() {\n        try {\n          await host.setTitleBar({\n            material: \"glass\",\n            background: \"rgba(7,17,24,.72)\",\n            color: \"#f3efe5\",\n            borderColor: \"rgba(255,255,255,.08)\",\n            buttonBackground: \"rgba(17,31,40,.78)\",\n            buttonColor: \"#f3efe5\",\n            buttonBorderColor: \"rgba(255,255,255,.12)\",\n            buttonRadius: \"999px\",\n            buttonShadow: \"0 8px 20px rgba(0,0,0,.22)\"\n          });\n        } catch (_) {}\n\n        try {\n          var profile = await host.getPlayerProfile();\n          if (profile && profile.name) player.name = String(profile.name);\n        } catch (_) {}\n\n        await chooseOpponent();\n\n        try {\n          var saved = await host.loadGame();\n          if (validSavedGame(saved) && (!saved.characterId || saved.characterId === role.id)) {\n            state = saved;\n            state.thinking = false;\n          }\n        } catch (_) {}\n\n        document.getElementById(\"playerName\").textContent = player.name;\n        document.getElementById(\"roleName\").textContent = role.name;\n        document.getElementById(\"difficulty\").value = state.difficulty || \"steady\";\n        bindEvents();\n        resizeBoard();\n        render();\n        if (!state.over && state.turn === ROLE) scheduleAi();\n      }\n\n      function bindEvents() {\n        canvas.addEventListener(\"pointerup\", onBoardPointer);\n        document.getElementById(\"undo\").addEventListener(\"click\", undoRound);\n        document.getElementById(\"restart\").addEventListener(\"click\", function () {\n          if (!state.over && state.history.length && !window.confirm(\"这局还没结束，要重新开一局吗？\")) return;\n          newRound();\n        });\n        document.getElementById(\"difficulty\").addEventListener(\"change\", function (event) {\n          var next = event.target.value;\n          if (state.history.length && !state.over && !window.confirm(\"更换棋力会重新开局，继续吗？\")) {\n            event.target.value = state.difficulty;\n            return;\n          }\n          state.difficulty = next;\n          newRound(true);\n        });\n        document.getElementById(\"keep\").addEventListener(\"click\", keepMatch);\n        document.getElementById(\"speak\").addEventListener(\"click\", askRoleToSpeak);\n        window.addEventListener(\"resize\", resizeBoard);\n        window.addEventListener(\"aiphone:safe-area-change\", function () { setTimeout(resizeBoard, 30); });\n      }\n\n      function resizeBoard() {\n        var rect = canvas.getBoundingClientRect();\n        var cssSize = Math.max(220, Math.floor(Math.min(rect.width, rect.height)));\n        var ratio = Math.min(window.devicePixelRatio || 1, 2);\n        canvas.width = Math.floor(cssSize * ratio);\n        canvas.height = Math.floor(cssSize * ratio);\n        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);\n        geometry.size = cssSize;\n        geometry.pad = Math.max(15, cssSize * .055);\n        geometry.step = (cssSize - geometry.pad * 2) / (SIZE - 1);\n        drawBoard();\n      }\n\n      function at(x, y) { return state.board[y * SIZE + x]; }\n      function setAt(x, y, value) { state.board[y * SIZE + x] = value; }\n      function inside(x, y) { return x >= 0 && y >= 0 && x < SIZE && y < SIZE; }\n\n      function onBoardPointer(event) {\n        if (state.over || state.thinking || state.turn !== HUMAN) return;\n        var rect = canvas.getBoundingClientRect();\n        var px = (event.clientX - rect.left) * geometry.size / rect.width;\n        var py = (event.clientY - rect.top) * geometry.size / rect.height;\n        var x = Math.round((px - geometry.pad) / geometry.step);\n        var y = Math.round((py - geometry.pad) / geometry.step);\n        if (!inside(x, y) || at(x, y) !== 0) return;\n        var gx = geometry.pad + x * geometry.step;\n        var gy = geometry.pad + y * geometry.step;\n        if (Math.hypot(px - gx, py - gy) > geometry.step * .48) return;\n        playMove(x, y, HUMAN);\n        if (!checkAfterMove(x, y, HUMAN)) {\n          state.turn = ROLE;\n          persist();\n          render();\n          scheduleAi();\n        }\n      }\n\n      function playMove(x, y, side) {\n        setAt(x, y, side);\n        state.history.push({ x: x, y: y, side: side });\n        drawBoard();\n      }\n\n      function checkAfterMove(x, y, side) {\n        if (hasFive(x, y, side)) {\n          finish(side);\n          return true;\n        }\n        if (state.history.length >= SIZE * SIZE) {\n          finish(3);\n          return true;\n        }\n        return false;\n      }\n\n      function hasFive(x, y, side) {\n        var dirs = [[1,0],[0,1],[1,1],[1,-1]];\n        return dirs.some(function (d) {\n          var count = 1;\n          var nx = x + d[0], ny = y + d[1];\n          while (inside(nx, ny) && at(nx, ny) === side) { count++; nx += d[0]; ny += d[1]; }\n          nx = x - d[0]; ny = y - d[1];\n          while (inside(nx, ny) && at(nx, ny) === side) { count++; nx -= d[0]; ny -= d[1]; }\n          return count >= 5;\n        });\n      }\n\n      function scheduleAi() {\n        state.thinking = true;\n        var token = ++turnToken;\n        render();\n        clearTimeout(aiTimer);\n        aiTimer = setTimeout(function () {\n          if (token !== turnToken || state.over || state.turn !== ROLE) return;\n          var move = chooseAiMove();\n          state.thinking = false;\n          if (!move) { finish(3); return; }\n          playMove(move.x, move.y, ROLE);\n          if (!checkAfterMove(move.x, move.y, ROLE)) {\n            state.turn = HUMAN;\n            persist();\n            render();\n          }\n        }, 380);\n      }\n\n      function chooseAiMove() {\n        if (!state.history.length) return { x: 7, y: 7 };\n        var candidates = candidateMoves();\n        var winning = candidates.find(function (p) { return wouldWin(p.x, p.y, ROLE); });\n        if (winning) return winning;\n        var block = candidates.find(function (p) { return wouldWin(p.x, p.y, HUMAN); });\n        if (block) return block;\n\n        var ranked = candidates.map(function (p) {\n          var attack = pointScore(p.x, p.y, ROLE);\n          var defense = pointScore(p.x, p.y, HUMAN);\n          var center = 13 - Math.abs(7 - p.x) - Math.abs(7 - p.y);\n          var noise = Math.random() * (state.difficulty === \"hard\" ? 2 : state.difficulty === \"steady\" ? 16 : 90);\n          return { x: p.x, y: p.y, score: attack + defense * 1.16 + center + noise };\n        }).sort(function (a, b) { return b.score - a.score; });\n\n        if (state.difficulty === \"easy\") return ranked[Math.floor(Math.random() * Math.min(7, ranked.length))] || ranked[0];\n        if (state.difficulty === \"steady\") return ranked[Math.floor(Math.random() * Math.min(2, ranked.length))] || ranked[0];\n        return ranked[0];\n      }\n\n      function candidateMoves() {\n        var map = Object.create(null);\n        state.history.forEach(function (m) {\n          for (var dy = -2; dy <= 2; dy++) {\n            for (var dx = -2; dx <= 2; dx++) {\n              var x = m.x + dx, y = m.y + dy;\n              if (inside(x, y) && at(x, y) === 0) map[x + \":\" + y] = { x: x, y: y };\n            }\n          }\n        });\n        return Object.keys(map).map(function (key) { return map[key]; });\n      }\n\n      function wouldWin(x, y, side) {\n        setAt(x, y, side);\n        var won = hasFive(x, y, side);\n        setAt(x, y, 0);\n        return won;\n      }\n\n      function pointScore(x, y, side) {\n        var dirs = [[1,0],[0,1],[1,1],[1,-1]];\n        return dirs.reduce(function (sum, d) {\n          var a = countRay(x, y, side, d[0], d[1]);\n          var b = countRay(x, y, side, -d[0], -d[1]);\n          var count = a.count + b.count + 1;\n          var open = a.open + b.open;\n          return sum + shapeScore(count, open);\n        }, 0);\n      }\n\n      function countRay(x, y, side, dx, dy) {\n        var count = 0;\n        var nx = x + dx, ny = y + dy;\n        while (inside(nx, ny) && at(nx, ny) === side) { count++; nx += dx; ny += dy; }\n        return { count: count, open: inside(nx, ny) && at(nx, ny) === 0 ? 1 : 0 };\n      }\n\n      function shapeScore(count, open) {\n        if (count >= 5) return 1000000;\n        if (count === 4 && open === 2) return 120000;\n        if (count === 4 && open === 1) return 24000;\n        if (count === 3 && open === 2) return 9000;\n        if (count === 3 && open === 1) return 1500;\n        if (count === 2 && open === 2) return 520;\n        if (count === 2 && open === 1) return 80;\n        return open ? 12 : 2;\n      }\n\n      function finish(winner) {\n        state.over = true;\n        state.winner = winner;\n        state.turn = 0;\n        state.thinking = false;\n        state.recorded = false;\n        if (winner === HUMAN) state.scores.human++;\n        if (winner === ROLE) state.scores.role++;\n        persist();\n        render();\n      }\n\n      function newRound(keepDifficulty) {\n        clearTimeout(aiTimer);\n        turnToken++;\n        var scores = state.scores;\n        var difficulty = keepDifficulty ? document.getElementById(\"difficulty\").value : state.difficulty;\n        state = freshState();\n        state.scores = scores;\n        state.difficulty = difficulty;\n        document.getElementById(\"reply\").classList.remove(\"show\");\n        document.getElementById(\"reply\").textContent = \"\";\n        persist();\n        render();\n      }\n\n      function undoRound() {\n        if (state.over || !state.history.length) return;\n        clearTimeout(aiTimer);\n        turnToken++;\n        state.thinking = false;\n        var removeCount = state.history[state.history.length - 1].side === ROLE ? 2 : 1;\n        while (removeCount-- > 0 && state.history.length) {\n          var move = state.history.pop();\n          setAt(move.x, move.y, 0);\n        }\n        state.turn = HUMAN;\n        persist();\n        render();\n      }\n\n      function resultText() {\n        if (state.winner === HUMAN) return player.name + \"执黑战胜了\" + role.name;\n        if (state.winner === ROLE) return role.name + \"执白赢下了这一局\";\n        return player.name + \"和\" + role.name + \"下成了和棋\";\n      }\n\n      async function keepMatch() {\n        if (!state.over || state.recorded) return;\n        var button = document.getElementById(\"keep\");\n        button.disabled = true;\n        button.textContent = \"正在保存……\";\n        try {\n          await host.recordGameEvent({\n            characterIds: [role.id],\n            title: \"夜局五子棋\",\n            summary: resultText() + \"，两人完成了一局夜局五子棋，共落下 \" + state.history.length + \" 手。\"\n          });\n          state.recorded = true;\n          await persist();\n          toast(\"这局已经收进共同抽屉\");\n        } catch (err) {\n          toast(err && err.message ? err.message : \"保存失败，请稍后再试\");\n        }\n        render();\n      }\n\n      async function askRoleToSpeak() {\n        if (!state.over) return;\n        var button = document.getElementById(\"speak\");\n        var reply = document.getElementById(\"reply\");\n        button.disabled = true;\n        button.textContent = \"正在想……\";\n        reply.textContent = \"\";\n        reply.classList.remove(\"show\");\n        try {\n          var pkg = await host.getRoleLightPackage(role.id);\n          if (Array.isArray(pkg)) pkg = pkg[0];\n          var messages = pkg && Array.isArray(pkg.messages) ? pkg.messages.slice() : [];\n          messages.push({\n            role: \"system\",\n            content: \"你刚和用户下完一局五子棋。请严格保持角色人设，用自然中文说一到两句话回应结果。不要写动作描写、舞台提示、分析过程或空洞鼓励，不要强行提问。\"\n          });\n          messages.push({ role: \"user\", content: \"本局结果：\" + resultText() + \"；总手数：\" + state.history.length + \"。\" });\n          var result = await host.callLLM({ characterId: role.id, messages: messages });\n          reply.textContent = result && result.content ? String(result.content).trim() : \"对方只是看了看棋盘。\";\n          reply.classList.add(\"show\");\n        } catch (err) {\n          toast(err && err.message ? err.message : \"角色回复失败\");\n        }\n        button.disabled = false;\n        button.textContent = \"让对手说一句\";\n      }\n\n      async function persist() {\n        var snapshot = JSON.parse(JSON.stringify(state));\n        snapshot.characterId = role.id;\n        snapshot.characterName = role.name;\n        try { await host.saveGame(snapshot); } catch (_) {}\n      }\n\n      function render() {\n        document.getElementById(\"playerScore\").textContent = state.scores.human;\n        document.getElementById(\"roleScore\").textContent = state.scores.role;\n        document.getElementById(\"undo\").disabled = state.over || !state.history.length;\n        document.getElementById(\"difficulty\").disabled = state.thinking;\n        var status = document.getElementById(\"status\");\n        var dot = document.getElementById(\"turnDot\");\n        dot.classList.toggle(\"white\", state.turn === ROLE);\n        if (state.over) status.textContent = resultText() + \"。\";\n        else if (state.thinking) status.textContent = role.name + \"正在看棋盘……\";\n        else status.textContent = \"轮到你了，执黑先行。\";\n\n        var endActions = document.getElementById(\"endActions\");\n        endActions.classList.toggle(\"show\", state.over);\n        document.getElementById(\"apiNote\").classList.toggle(\"show\", state.over);\n        var keep = document.getElementById(\"keep\");\n        keep.disabled = !state.over || state.recorded;\n        keep.textContent = state.recorded ? \"已经留下\" : \"把这局留下\";\n        drawBoard();\n      }\n\n      function drawBoard() {\n        if (!geometry.size) return;\n        var size = geometry.size;\n        var pad = geometry.pad;\n        var step = geometry.step;\n        ctx.clearRect(0, 0, size, size);\n\n        var wood = ctx.createLinearGradient(0, 0, size, size);\n        wood.addColorStop(0, \"#d8aa68\");\n        wood.addColorStop(.5, \"#c58c49\");\n        wood.addColorStop(1, \"#b8783d\");\n        ctx.fillStyle = wood;\n        ctx.fillRect(0, 0, size, size);\n\n        ctx.strokeStyle = \"rgba(52,32,18,.68)\";\n        ctx.lineWidth = Math.max(1, size / 420);\n        ctx.beginPath();\n        for (var i = 0; i < SIZE; i++) {\n          var p = pad + i * step;\n          ctx.moveTo(pad, p); ctx.lineTo(size - pad, p);\n          ctx.moveTo(p, pad); ctx.lineTo(p, size - pad);\n        }\n        ctx.stroke();\n\n        [[3,3],[11,3],[7,7],[3,11],[11,11]].forEach(function (s) {\n          ctx.beginPath();\n          ctx.fillStyle = \"rgba(52,32,18,.78)\";\n          ctx.arc(pad + s[0] * step, pad + s[1] * step, Math.max(2, step * .095), 0, Math.PI * 2);\n          ctx.fill();\n        });\n\n        for (var y = 0; y < SIZE; y++) {\n          for (var x = 0; x < SIZE; x++) {\n            var side = at(x, y);\n            if (side) drawStone(pad + x * step, pad + y * step, side, step * .43);\n          }\n        }\n\n        var last = state.history[state.history.length - 1];\n        if (last) {\n          ctx.beginPath();\n          ctx.strokeStyle = last.side === HUMAN ? \"#e6ad58\" : \"#2b6f67\";\n          ctx.lineWidth = Math.max(1.5, step * .075);\n          ctx.arc(pad + last.x * step, pad + last.y * step, step * .19, 0, Math.PI * 2);\n          ctx.stroke();\n        }\n      }\n\n      function drawStone(x, y, side, radius) {\n        ctx.save();\n        ctx.shadowColor = \"rgba(0,0,0,.38)\";\n        ctx.shadowBlur = radius * .42;\n        ctx.shadowOffsetY = radius * .16;\n        var g = ctx.createRadialGradient(x - radius * .34, y - radius * .38, radius * .12, x, y, radius);\n        if (side === HUMAN) {\n          g.addColorStop(0, \"#5d6669\");\n          g.addColorStop(.34, \"#22282b\");\n          g.addColorStop(1, \"#07090a\");\n        } else {\n          g.addColorStop(0, \"#ffffff\");\n          g.addColorStop(.48, \"#eeeae0\");\n          g.addColorStop(1, \"#b8b3aa\");\n        }\n        ctx.beginPath();\n        ctx.fillStyle = g;\n        ctx.arc(x, y, radius, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.restore();\n      }\n\n      function toast(message) {\n        var node = document.getElementById(\"toast\");\n        node.textContent = message;\n        node.classList.add(\"show\");\n        clearTimeout(toastTimer);\n        toastTimer = setTimeout(function () { node.classList.remove(\"show\"); }, 2200);\n      }\n\n      boot().catch(function (err) {\n        document.getElementById(\"status\").textContent = err && err.message ? err.message : \"游戏启动失败\";\n      });\n    })();\n  </script>\n</body>\n</html>\n",
    "allowExternalControl": true
  }
